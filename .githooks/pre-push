#!/usr/bin/env bash
# Profundidad graduada: pre-push es el gate real de este repo (no hay CI hosteado,
# ver README §"NO es de grado productivo"). main exige la suite completa; el resto
# de las ramas solo el typecheck, para no frenar iteración local.
set -euo pipefail

branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "main" ]; then
	make validate
else
	make typecheck
fi
