#!/usr/bin/env bash
# Profundidad graduada (ver README §"NO es de grado productivo"): pre-commit se mantiene
# barato a propósito. La validación completa vive en pre-push, no acá.
set -euo pipefail

if command -v gitleaks >/dev/null 2>&1; then
	gitleaks protect --staged --no-banner --redact
else
	echo "⚠️  gitleaks no está instalado — se omite el escaneo de secretos." >&2
fi

staged_ts_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx' || true)

if [ -n "$staged_ts_files" ]; then
	if [ -x web/node_modules/.bin/biome ]; then
		echo "$staged_ts_files" | xargs web/node_modules/.bin/biome check --write --no-errors-on-unmatched
		echo "$staged_ts_files" | xargs git add
	else
		echo "⚠️  Biome no está instalado en web/ todavía — se omite el formateo." >&2
	fi
fi

exit 0
